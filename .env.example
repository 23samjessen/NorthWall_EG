# Local development only. Copy to .dev.vars for a fresh portable checkout.
# Hosted production identity is supplied by the supported hosting gateway.
# Configure the real hosted administrator through server runtime settings.
ADMIN_EMAILS="seedy@sites.test"

# Optional public advertising configuration (build-time; a rebuild is required).
# Leave disabled until your Pixel IDs and the provider account settings are reviewed.
# See docs/MARKETING_AND_COOKIES.md. These IDs are public, never use access tokens here.
NEXT_PUBLIC_MARKETING_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_META_MANUAL_MODE_CONFIRMED=false
NEXT_PUBLIC_TIKTOK_MANUAL_MODE_CONFIRMED=false
