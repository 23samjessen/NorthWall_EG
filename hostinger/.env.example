# Set these in Hostinger's private environment-variable settings. Never commit real values.
# Legacy Git-source custom-server selector; not needed by the native Next.js ZIP.
NORTHWALL_RUNTIME=hostinger
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://northwallegy.com
ADDITIONAL_HOSTS=www.northwallegy.com
# Set true only after Hostinger SSL and Force HTTPS are enabled and verified.
EDGE_HTTPS_CONFIRMED=false
# Keep false until the company is registered and you choose to publish publicly.
PUBLIC_LAUNCH=false
OWNER_EMAIL=23samjessen@gmail.com
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Only required for a remote database; local Hostinger MySQL needs no CA setting.
DB_SSL_CA_BASE64=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
